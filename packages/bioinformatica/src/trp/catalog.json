          },
          "namespace": "pdb",
          "chain": "author",
          "numbering": "pdb-author",
          "insertionCodes": "excluded",
          "confidence": "none",
          "constraints": [
            "PDB identifiers are normalized to lowercase; chain identifiers remain case-sensitive",
            "Exactly one selected model and author chain",
            "Selected residues have unambiguous CA atoms",
            "No author insertion codes in the selected chain",
            "Input basename starts with the matching four-character PDB identifier"
          ],
          "scales": [
            {
              "field": "xyz",
              "meaning": "atomic coordinates",
              "unit": "angstrom",
              "direction": "none"
            },
            {
              "field": "B-factor",
              "meaning": "experimental displacement parameter; not pLDDT",
              "unit": "angstrom^2",
              "direction": "none"
            }
          ]
        },
        {
          "id": "units",
          "data": {
            "uri": "http://edamontology.org/data_1537",
            "term": "Protein structure report"
          },
          "format": {
            "uri": "http://edamontology.org/format_3464",
            "term": "JSON"
          },
          "namespace": "pdb",
          "chain": "author",
          "numbering": "pdb-author",
          "insertionCodes": "excluded",
          "confidence": "none",
          "constraints": [
            "Explicit approved unit boundaries, ordered and disjoint, with at least two nonempty units",
            "Unit boundaries are integer author residue numbers, not sequence offsets",
            "Missing residues and insertion intervals must be declared before execution"
          ],
          "scales": []
        }
      ],
      "outputs": [
        {
          "id": "geometry",
          "data": {
            "uri": "http://edamontology.org/data_1537",
            "term": "Protein structure report"
          },
          "format": {
            "uri": "http://edamontology.org/format_3752",
            "term": "CSV"
          },
          "namespace": "pdb",
          "chain": "author",
          "numbering": "pdb-author",
          "insertionCodes": "excluded",
          "confidence": "none",
          "constraints": [
            "Single-mode CSV only",
            "First unit is a zero placeholder; mean and std rows summarize pairs and are not residues",
            "Expected unit count and boundaries must be preserved; reject empty or non-finite output"
          ],
          "scales": [
            {
              "field": "curvature",
              "meaning": "geometric rotation angle; not a confidence score",
              "unit": "radian",
              "minimum": 0,
              "direction": "none"
            },
            {
              "field": "twist",
              "meaning": "geometric rotation angle; not a confidence score",
              "unit": "radian",
              "minimum": 0,
              "direction": "none"
            },
            {
              "field": "pitch",
              "meaning": "geometric rotation angle; not a confidence score",
              "unit": "radian",
              "minimum": 0,
              "direction": "none"
            },
            {
              "field": "yaw",
              "meaning": "geometric rotation angle; not a confidence score",
              "unit": "radian",
              "minimum": 0,
              "direction": "none"
            },
            {
              "field": "tmscore",
              "meaning": "TM-align structural similarity between adjacent units; not pLDDT",
              "unit": "dimensionless",
              "minimum": 0,
              "maximum": 1,
              "direction": "higher"
            },
            {
              "field": "twist_hand,pitch_hand",
              "meaning": "sign of rotation; summary rows are mean and standard deviation of signs",
              "unit": "dimensionless",
              "direction": "none"
            }
          ]
        }
      ],
      "parameters": ["chain", "units", "insertions (optional)", "window=6 (upstream default; no CLI override)"],
      "limitations": [
        "Requires previously supplied repeat-unit boundaries; does not detect repeats.",
        "Admission covers single mode and PDB format. Batch, mmCIF, alternate conformations, multichain structures and general missing-coordinate handling are not validated by this reference.",
        "The upstream implementation can discard empty units and can exit successfully without a CSV. The wrapper checks the output explicitly.",
        "The auxiliary NPY contains Python objects; recorded as opaque bytes and never loaded by the verifier.",
        "A local Docker digest identifies the tested image; this phase does not publish an image to a registry.",
        "F3 reference image adds procps 2:4.0.2-3 for Nextflow task metrics; scientific packages and reference CSV are unchanged. The original F2 reference is retained."
      ],
